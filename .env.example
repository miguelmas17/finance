# Copia este archivo a .env y rellena los valores.

# Clave de la API de Anthropic (Claude), necesaria para analizar las
# capturas de pantalla de gastos. Consíguela en https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Ruta de la base de datos SQLite (por defecto un fichero local).
DATABASE_URL="file:./dev.db"
