# Copia este archivo a .env y rellena los valores.

# Clave de la API de Anthropic (Claude), necesaria para analizar las
# capturas de pantalla de gastos. Consíguela en https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Cadena de conexión de PostgreSQL. En local puedes usar un Postgres propio;
# en producción, la cadena de conexión que te da Neon (ver README).
DATABASE_URL="postgresql://usuario:contraseña@host:5432/basededatos"
